@using UMR.Requestor.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-circle error-icon"></i>
                </div>
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-danger text-white py-3">
                        <h4 class="mb-0 text-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Oops! Something went wrong
                        </h4>
                    </div>
                    <div class="card-body p-4">
                        @if (Model?.ShowRequestId ?? false)
                        {
                            <div class="alert alert-info bg-light border">
                                <strong>Request ID:</strong> 
                                <code class="ms-2 p-1 bg-light rounded">@Model.RequestId</code>
                            </div>
                        }

                        <h5 class="card-title text-center mb-4">
                            @(Model?.Message ?? "An error occurred while processing your request.")
                        </h5>

                        @if (!string.IsNullOrEmpty(Model?.DetailedMessage))
                        {
                            <div class="alert alert-secondary mt-3 bg-light border">
                                <pre class="mb-0"><code>@Model.DetailedMessage</code></pre>
                            </div>
                        }

                        <div class="mt-4 text-center">
                            <a href="/" class="btn btn-primary btn-lg hover-effect me-3">
                                <i class="bi bi-house-fill me-2"></i>Return Home
                            </a>
                            <button onclick="history.back()" class="btn btn-outline-secondary btn-lg hover-effect">
                                <i class="bi bi-arrow-left me-2"></i>Go Back
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .error-page {
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
            padding: 2rem 0;
        }

        .error-icon {
            font-size: 5rem;
            color: #dc3545;
            margin-bottom: 2rem;
            animation: pulse 2s infinite;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            border-bottom: none;
        }

        .hover-effect {
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .hover-effect:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,0.2) 50%,
                rgba(255,255,255,0) 100%
            );
            transition: all 0.5s ease;
        }

        .hover-effect:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .hover-effect:hover:before {
            left: 100%;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-weight: 500;
        }

        .alert {
            border-radius: 10px;
        }

        pre {
            white-space: pre-wrap;
            word-wrap: break-word;
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        code {
            color: #6c757d;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.05);
                opacity: 0.8;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@media (max-width: 768px) {
            .btn-lg {
                width: 100%;
                margin-bottom: 1rem;
            }
            
            .error-icon {
                font-size: 4rem;
            }
        }
    </style>
}